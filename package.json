{
  "name": "orbiter-bridge",
  "version": "1.1.0",
  "description": "Orbiter Dev bridge - Claude Code hook integration for mobile approvals",
  "homepage": "https://orbiterdev.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbiterdev-ai/orbiter-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/orbiterdev-ai/orbiter-bridge/issues"
  },
  "main": "dist/pre-check.js",
  "bin": {
    "orbiter-bridge": "index.js",
    "orbiter-setup-hooks": "dist/setup.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "precheck": "node dist/pre-check.js",
    "posthook": "node dist/post-hook.js",
    "setup-hooks": "node dist/setup.js"
  },
  "keywords": [
    "orbiter",
    "claude-code",
    "hooks",
    "approval",
    "mcp"
  ],
  "author": "Orbiter Dev",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.1",
    "dotenv": "^17.2.3",
    "eventsource": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
